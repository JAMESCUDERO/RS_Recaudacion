  <DataSets>
    <DataSet Name="DS_FechaActualizacion">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <CommandText>SELECT MAX(FC.FechaEntidadExterna) AS FechaActualizacion
FROM RECAUDACION_DM.DesgloseCobros.FactCobro F WITH (NOLOCK)
INNER JOIN RECAUDACION_DM.DesgloseCobros.DimFechaEntidadExterna FC WITH (NOLOCK)
  ON F.IdDimFechaEntidadExterna = FC.IdDimFechaEntidadExterna
WHERE F.Estado = 'Pago'</CommandText>
      </Query>
      <Fields>
        <Field Name="FechaActualizacion">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FechaActualizacion</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_Transaccion">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <CommandText>SELECT '' AS Transaccion
UNION ALL
SELECT DISTINCT Transaccion
FROM RECAUDACION_DM.DesgloseCobros.DimTransaccion
ORDER BY Transaccion</CommandText>
      </Query>
      <Fields>
        <Field Name="Transaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Transaccion</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_SubTransaccion">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Transaccion">
            <Value>=Parameters!Transaccion.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT '' AS SubTransaccion
UNION ALL
SELECT DISTINCT SubTransaccion
FROM RECAUDACION_DM.DesgloseCobros.DimTransaccion
WHERE (@Transaccion = '' OR Transaccion = @Transaccion)
ORDER BY SubTransaccion</CommandText>
      </Query>
      <Fields>
        <Field Name="SubTransaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SubTransaccion</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_DesgloseTransaccion">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Transaccion">
            <Value>=Parameters!Transaccion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SubTransaccion">
            <Value>=Parameters!SubTransaccion.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT '' AS Transaccion
UNION ALL
SELECT DISTINCT DIM_TRANSACCION_DESGLOSE.Transaccion
FROM RECAUDACION_DM.DesgloseCobros.FactCobro FACT_COBRO WITH (NOLOCK)
INNER JOIN RECAUDACION_DM.DesgloseCobros.FactDesgloseCobro FACT_DESGLOSE_COBRO WITH (NOLOCK)
  ON FACT_COBRO.IdFactCobro = FACT_DESGLOSE_COBRO.IdFactCobro
INNER JOIN RECAUDACION_DM.[DesgloseCobros].[DimTransaccionDesglose] DIM_TRANSACCION_DESGLOSE WITH (NOLOCK)
  ON FACT_DESGLOSE_COBRO.IdDimTransaccionDesglose = DIM_TRANSACCION_DESGLOSE.IdDimTransaccionDesglose
INNER JOIN RECAUDACION_DM.DesgloseCobros.DimTransaccion DIM_TRANSACCION WITH (NOLOCK)
  ON FACT_COBRO.IdDimTransaccion = DIM_TRANSACCION.IdDimTransaccion
WHERE FACT_COBRO.MotivoReverso is not null
  AND (@Transaccion = '' OR DIM_TRANSACCION.Transaccion = @Transaccion)
  AND (@SubTransaccion = '' OR DIM_TRANSACCION.SubTransaccion = @SubTransaccion)
ORDER BY Transaccion</CommandText>
      </Query>
      <Fields>
        <Field Name="Transaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Transaccion</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_DesgloseSubTransaccion">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Transaccion">
            <Value>=Parameters!Transaccion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SubTransaccion">
            <Value>=Parameters!SubTransaccion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DesgloseTransaccion">
            <Value>=Parameters!DesgloseTransaccion.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT '' AS SubTransaccion
UNION ALL
SELECT DISTINCT DIM_TRANSACCION_DESGLOSE.SubTransaccion
FROM RECAUDACION_DM.DesgloseCobros.FactCobro FACT_COBRO WITH (NOLOCK)
INNER JOIN RECAUDACION_DM.DesgloseCobros.FactDesgloseCobro FACT_DESGLOSE_COBRO WITH (NOLOCK)
  ON FACT_COBRO.IdFactCobro = FACT_DESGLOSE_COBRO.IdFactCobro
INNER JOIN RECAUDACION_DM.[DesgloseCobros].[DimTransaccionDesglose] DIM_TRANSACCION_DESGLOSE WITH (NOLOCK)
  ON FACT_DESGLOSE_COBRO.IdDimTransaccionDesglose = DIM_TRANSACCION_DESGLOSE.IdDimTransaccionDesglose
INNER JOIN RECAUDACION_DM.DesgloseCobros.DimTransaccion DIM_TRANSACCION WITH (NOLOCK)
  ON FACT_COBRO.IdDimTransaccion = DIM_TRANSACCION.IdDimTransaccion
WHERE FACT_COBRO.MotivoReverso is not null
  AND (@Transaccion = '' OR DIM_TRANSACCION.Transaccion = @Transaccion)
  AND (@SubTransaccion = '' OR DIM_TRANSACCION.SubTransaccion = @SubTransaccion)
  AND (@DesgloseTransaccion = '' OR DIM_TRANSACCION_DESGLOSE.Transaccion = @DesgloseTransaccion)
ORDER BY SubTransaccion</CommandText>
      </Query>
      <Fields>
        <Field Name="SubTransaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SubTransaccion</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DesgloseCobros">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FechaDesde">
            <Value>=Parameters!FechaDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaHasta">
            <Value>=Parameters!FechaHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaReversoDesde">
            <Value>=Parameters!FechaReversoDesde.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaReversoHasta">
            <Value>=Parameters!FechaReversoHasta.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Transaccion">
            <Value>=Parameters!Transaccion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SubTransaccion">
            <Value>=Parameters!SubTransaccion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DesgloseTransaccion">
            <Value>=Parameters!DesgloseTransaccion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DesgloseSubTransaccion">
            <Value>=Parameters!DesgloseSubTransaccion.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
FACT_COBRO.IdFactCobro
,FACT_COBRO.IdCobro
,DIM_FECHA_COBRO_RECAUDACION.FechaEntidadExterna as FechaCobro
,DIMCONTRIBU.NombreContribuyente
,DIM_TRANSACCION.Transaccion
,DIM_TRANSACCION.SubTransaccion
,[Desglose Transaccion] = DIM_TRANSACCION_DESGLOSE.Transaccion
,[Desglose SubTransaccion] = DIM_TRANSACCION_DESGLOSE.SubTransaccion
,FACT_COBRO.Estado
,FechaReverso = cast(FACT_COBRO.FechaReverso as date)
,FACT_COBRO.MotivoReverso
,Valor = FACT_DESGLOSE_COBRO.Valor * sign(FACT_COBRO.Total)

FROM RECAUDACION_DM.DesgloseCobros.FactCobro FACT_COBRO with (nolock)

INNER JOIN RECAUDACION_DM.DesgloseCobros.FactDesgloseCobro FACT_DESGLOSE_COBRO with (nolock)
ON (FACT_COBRO.IdFactCobro = FACT_DESGLOSE_COBRO.IdFactCobro)

INNER JOIN RECAUDACION_DM.[DesgloseCobros].[DimTransaccionDesglose] DIM_TRANSACCION_DESGLOSE with (nolock)
ON FACT_DESGLOSE_COBRO.IdDimTransaccionDesglose = DIM_TRANSACCION_DESGLOSE.IdDimTransaccionDesglose

INNER JOIN RECAUDACION_DM.DesgloseCobros.DimFechaEntidadExterna DIM_FECHA_COBRO_RECAUDACION with (nolock)
ON (FACT_COBRO.IdDimFechaEntidadExterna = DIM_FECHA_COBRO_RECAUDACION.IdDimFechaEntidadExterna)

INNER JOIN RECAUDACION_DM.DesgloseCobros.DimTransaccion DIM_TRANSACCION with (nolock)
ON (FACT_COBRO.IdDimTransaccion = DIM_TRANSACCION.IdDimTransaccion)

INNER JOIN RECAUDACION_DM.[DesgloseCobros].[DimContribuyente] DIMCONTRIBU with (nolock)
ON (FACT_COBRO.IdDimContribuyente = DIMCONTRIBU.IdDimContribuyente)

WHERE FACT_COBRO.MotivoReverso is not null
  AND (@FechaDesde is null OR DIM_FECHA_COBRO_RECAUDACION.FechaEntidadExterna &gt;= @FechaDesde)
  AND (@FechaHasta is null OR DIM_FECHA_COBRO_RECAUDACION.FechaEntidadExterna &lt;  DATEADD(day, 1, @FechaHasta))
  AND (@FechaReversoDesde is null OR FACT_COBRO.FechaReverso &gt;= @FechaReversoDesde)
  AND (@FechaReversoHasta is null OR FACT_COBRO.FechaReverso &lt;  DATEADD(day, 1, @FechaReversoHasta))
  AND (@Transaccion    = '' OR DIM_TRANSACCION.Transaccion    = @Transaccion)
  AND (@SubTransaccion = '' OR DIM_TRANSACCION.SubTransaccion = @SubTransaccion)
  AND (@DesgloseTransaccion = '' OR DIM_TRANSACCION_DESGLOSE.Transaccion = @DesgloseTransaccion)
  AND (@DesgloseSubTransaccion = '' OR DIM_TRANSACCION_DESGLOSE.SubTransaccion = @DesgloseSubTransaccion)

ORDER BY
   FACT_COBRO.IdCobro
  ,DIMCONTRIBU.NombreContribuyente
  ,DIM_TRANSACCION.Transaccion
  ,DIM_TRANSACCION.SubTransaccion
  ,DIM_TRANSACCION_DESGLOSE.Transaccion
  ,FACT_COBRO.Estado
  ,DIM_TRANSACCION_DESGLOSE.SubTransaccion</CommandText>
        <Timeout>120</Timeout>
      </Query>
      <Fields>
        <Field Name="IdCobro">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IdCobro</DataField>
        </Field>
        <Field Name="FechaCobro">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FechaCobro</DataField>
        </Field>
        <Field Name="NombreContribuyente">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>NombreContribuyente</DataField>
        </Field>
        <Field Name="Transaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Transaccion</DataField>
        </Field>
        <Field Name="SubTransaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SubTransaccion</DataField>
        </Field>
        <Field Name="DesgloseTransaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Desglose Transaccion</DataField>
        </Field>
        <Field Name="DesgloseSubTransaccion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Desglose SubTransaccion</DataField>
        </Field>
        <Field Name="Estado">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Estado</DataField>
        </Field>
        <Field Name="FechaReverso">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FechaReverso</DataField>
        </Field>
        <Field Name="MotivoReverso">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MotivoReverso</DataField>
        </Field>
        <Field Name="Valor">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Valor</DataField>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=IIF(((NOT(Parameters!FechaDesde.Value Is Nothing) AndAlso NOT(Parameters!FechaHasta.Value Is Nothing)) OrElse (NOT(Parameters!FechaReversoDesde.Value Is Nothing) AndAlso NOT(Parameters!FechaReversoHasta.Value Is Nothing))) AndAlso (Parameters!FechaDesde.Value Is Nothing OrElse Parameters!FechaHasta.Value Is Nothing OrElse DateDiff("d", Parameters!FechaDesde.Value, Parameters!FechaHasta.Value) &lt;= 31) AndAlso (Parameters!FechaReversoDesde.Value Is Nothing OrElse Parameters!FechaReversoHasta.Value Is Nothing OrElse DateDiff("d", Parameters!FechaReversoDesde.Value, Parameters!FechaReversoHasta.Value) &lt;= 31), 1, 0)</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue DataType="Integer">1</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
  </DataSets>
