            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!FechaTransaccion.Value, "DS_CEP"), "dd/MM/yyyy")</Value>
