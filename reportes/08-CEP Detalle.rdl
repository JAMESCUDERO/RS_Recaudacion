    <DataSet Name="DS_Temporales">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CEP">
            <Value>=Parameters!CEP.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP 200
   CAST(TEM.[IdCobro] AS NVARCHAR(50))           AS IdCobro
  ,CAST(TEM.[IdLiquidacion] AS NVARCHAR(50))     AS IdLiquidacion
  ,EST.Descripcion                               AS Estado
  ,CAT.Descripcion                               AS Catalogo
  ,TEM.[FechaCompensacion]
  ,TEM.[Total]
  ,TEM.[NombreContribuyente]
  ,TEM.[FechaReverso]
  ,TEM.[MotivoReverso]
  ,CAST(TEM.IdBanco AS NVARCHAR(50))             AS Banco
  ,CAJ.NombreCajero                              AS Cajero
  ,CAST(TEM.[IdApertura] AS NVARCHAR(50))        AS IdApertura
FROM [H16].[RECAUDACION].[dbo].[SmrCobrosElectronicosTemporales] TEM WITH (NOLOCK)
INNER JOIN [H16].[RECAUDACION].[dbo].[SmrEstados] EST WITH (NOLOCK)
  ON TEM.Estado = EST.IdEstado
INNER JOIN [H16].[RECAUDACION].[dbo].[SmrCatalogos] CAT WITH (NOLOCK)
  ON TEM.CodCatalogo = CAT.CodCatalogo
INNER JOIN [H16].[RECAUDACION].[dbo].[SmrCajeros] CAJ WITH (NOLOCK)
  ON TEM.IdCajero = CAJ.IdCajero
WHERE CAST(TEM.CEP AS NVARCHAR(50)) = @CEP
ORDER BY TEM.FechaCompensacion DESC</CommandText>
        <Timeout>60</Timeout>
      </Query>
      <Fields>
        <Field Name="IdCobro">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IdCobro</DataField>
        </Field>
        <Field Name="IdLiquidacion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IdLiquidacion</DataField>
        </Field>
        <Field Name="Estado">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Estado</DataField>
        </Field>
        <Field Name="Catalogo">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Catalogo</DataField>
        </Field>
        <Field Name="FechaCompensacion">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FechaCompensacion</DataField>
        </Field>
        <Field Name="Total">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Total</DataField>
        </Field>
        <Field Name="NombreContribuyente">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>NombreContribuyente</DataField>
        </Field>
        <Field Name="FechaReverso">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>FechaReverso</DataField>
        </Field>
        <Field Name="MotivoReverso">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MotivoReverso</DataField>
        </Field>
        <Field Name="Banco">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Banco</DataField>
        </Field>
        <Field Name="Cajero">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Cajero</DataField>
        </Field>
        <Field Name="IdApertura">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>IdApertura</DataField>
        </Field>
