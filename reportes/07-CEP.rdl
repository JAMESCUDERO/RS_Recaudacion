                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#cccccc</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=IIF(RowNumber(Nothing) Mod 2 = 0,"#EEF2F7","White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
