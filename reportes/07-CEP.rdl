  <DataSets>
    <DataSet Name="DS_CEP">
      <Query>
        <DataSourceName>RECAUDACION_DM</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CEP">
            <Value>=Parameters!CEP.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Identificacion">
            <Value>=Parameters!Identificacion.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@NombreContribuyente">
            <Value>=Parameters!NombreContribuyente.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@IdCobro">
            <Value>=Parameters!IdCobro.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP 100
   CEP.CEP
  ,CAT.Descripcion                                AS Catalogo
  ,CEP.CodAplicacion
  ,CEP.CodTramite
  ,CEP.DescripcionTramite
  ,CEP.AnioTransaccion
  ,CAST(CEP.NumeroTransaccion AS NVARCHAR(50))    AS NumeroTransaccion
  ,CEP.FechaTransaccion
  ,CEP.NumeroIdentificacion
  ,CEP.NombreContribuyente
  ,CAST(CEP.IdSector AS NVARCHAR(50))             AS IdSector
  ,CAST(CEP.Manzana AS NVARCHAR(50))              AS Manzana
  ,CAST(CEP.Lote AS NVARCHAR(50))                 AS Lote
  ,CAST(CEP.Division AS NVARCHAR(50))             AS Division
  ,CAST(CEP.Phv AS NVARCHAR(50))                  AS Phv
  ,CAST(CEP.Phh AS NVARCHAR(50))                  AS Phh
  ,CAST(CEP.NumeroPredio AS NVARCHAR(50))         AS Numero
  ,CAST(CEP.IdCobro AS NVARCHAR(50))              AS IdCobro
  ,CEP.FechaCobro
  ,CEP.ValorTasa
  ,CEP.ValorDeuda
  ,CEP.ValorMulta
  ,CEP.ValorInteres
  ,CEP.ValorCoactiva
  ,CEP.ValorDescuento
  ,CEP.ValorTotal
  ,CEP.FechaExigibilidad
  ,CEP.FechaVencimiento
  ,EST.Descripcion                                AS Estado
  ,CEP.Observacion1
  ,CEP.Observacion2
  ,CEP.Observacion3
  ,CEP.ValorDeudaO
  ,CEP.ValorRecargo
FROM [H16].[RECAUDACION].[dbo].[SmrCodigoElectronicoPago] CEP WITH (NOLOCK)
INNER JOIN [H16].[RECAUDACION].[dbo].[SmrEstados] EST WITH (NOLOCK)
  ON CEP.Estado = EST.IdEstado
INNER JOIN [H16].[RECAUDACION].[dbo].[SmrCatalogos] CAT WITH (NOLOCK)
  ON CEP.CodCatalogo = CAT.CodCatalogo
WHERE CEP.PdpEstado = 1
  AND (@CEP = '' OR CEP.CEP = @CEP)
  AND (@Identificacion = '' OR CEP.NumeroIdentificacion = @Identificacion)
  AND (@NombreContribuyente = '' OR UPPER(CEP.NombreContribuyente) LIKE '%' + UPPER(@NombreContribuyente) + '%')
  AND (@IdCobro = '' OR CAST(CEP.IdCobro AS NVARCHAR(50)) = @IdCobro)
ORDER BY CEP.FechaCobro DESC, CEP.FechaExigibilidad DESC</CommandText>
        <Timeout>60</Timeout>
      </Query>
